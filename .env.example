# mock mode - when true, every adapter (lib/adapters/*) uses fixture data
# regardless of which keys below are set. Flip to false once you want real calls.
MOCK_MODE=true

# supabase (required even in mock mode - auth and storage run for real)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# claude api - planner, classifier, writer roles
ANTHROPIC_API_KEY=

# google gemini - grounded research (real web search, not training-data recall)
GEMINI_API_KEY=

# sandboxed python compute (data analysis, ML, backtests)
E2B_API_KEY=

# S10 Scheduled Agents - Vercel sets this automatically for its own Cron Jobs; set it
# yourself too (same value, as a project env var) so /api/cron can verify the caller.
# Without it set, /api/cron accepts any request - fine locally, not for a real deployment.
CRON_SECRET=

# Operator gate for /api/jobs and /api/schedules - the routes that run the pipeline
# outside x402. Without it those routes serve the paid services for free to anyone who
# knows the path. REQUIRED in production: they fail closed (503) when it is unset, except
# under MOCK_MODE=true. The /run console asks for this value once and keeps it in
# localStorage. Use a dedicated random string - never the Supabase service-role key, since
# the browser sends this one.
OPERATOR_KEY=

# Optional. Shared secret for the internal /api/jobs/process dispatch; falls back to
# SUPABASE_SERVICE_ROLE_KEY when unset. Server-to-server only, never sent to a browser.
JOBS_SECRET=

# on-chain data
# MORALIS_API_KEY also gates S11 RWA Analytics' real mode (holder counts) - TVL/APY for that
# service come from DeFiLlama's public API, no key needed. See lib/adapters/rwa/real.ts.
MORALIS_API_KEY=
DUNE_API_KEY=
# S5 On-chain Analytics reads these Dune query ids - write the SQL on dune.com first,
# each query must accept a token_address parameter. See lib/adapters/dune/real.ts.
DUNE_QUERY_ID_HOLDERS=
DUNE_QUERY_ID_WHALES=
DUNE_QUERY_ID_PROTOCOL=

# market data
COINGECKO_API_KEY=
# S6 Market Intelligence equity quotes - Finnhub's free tier (60 calls/min) replaced
# Alpha Vantage (25/day) after that quota blocked repeated real-mode testing.
FINNHUB_API_KEY=

# Algorand x402 pay-per-request endpoints (app/api/x402/*).
# Test with X402_ALGORAND_NETWORK=testnet first, then switch production to mainnet.
# Mainnet competition volume only counts when settled through GoPlausible to one
# Algorand payTo address that is opted in to USDC ASA 31566704.
FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_ALGORAND_NETWORK=testnet
AVM_ADDRESS=
# Optional Algod overrides used by @x402-avm/avm when verifying Algorand payments.
ALGOD_TESTNET_URL=
ALGOD_MAINNET_URL=
